{
  "name": "dsh-sidecar",
  "version": "0.4.0",
  "description": "Background sidecar subagents for dsh: fire a focused task, keep the main thread moving, and queue a thorough review of the result.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sidecar",
    "subagent",
    "background",
    "review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenjoe41/dsh-sidecar.git"
  },
  "homepage": "https://github.com/kenjoe41/dsh-sidecar#readme",
  "bugs": {
    "url": "https://github.com/kenjoe41/dsh-sidecar/issues"
  }
}
